# Set EXTRA_ARGS depending on whether the first argument was a script flag
case "$1" in
    -is|--installscr) EXTRA_ARGS=("${@:2}"); install_script ;;
    -b|--backend)     EXTRA_ARGS=("${@:2}"); switch_backend ;;
    -p|--patch)       EXTRA_ARGS=("${@:3}"); apply_patch "${2:-}" ;;
    -i|--install)     EXTRA_ARGS=("${@:2}"); install_llm_core ;;
    -u|--upgrade)     EXTRA_ARGS=("${@:2}"); upgrade_llm_core ;;
    -e|--edit)        EXTRA_ARGS=("${@:2}"); edit_script ;;
    -sm|--scan-models) EXTRA_ARGS=("${@:2}"); scan_models ;;
    -s|--settings)    EXTRA_ARGS=("${@:2}"); configure_settings ;;
    -d|--delete)      EXTRA_ARGS=("${@:2}"); delete_model ;;
