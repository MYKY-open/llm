run_cmake() {
    if ! cmake "$@"; then
        echo -e "\n[CMake] Configuration failed! This often happens if the project directory was moved."
        echo "[CMake] Cleaning CMake cache and retrying..."
        rm -rf build/CMakeCache.txt build/CMakeFiles
        cmake "$@"
    fi
}

# Bytes -> human string. awk keeps this portable (numfmt is not everywhere).
human_size() {
    awk -v b="${1:-0}" 'BEGIN {
        if (b < 1024)            printf "%d B", b
        else if (b < 1048576)    printf "%.0f KB", b / 1024
        else if (b < 1073741824) printf "%.0f MB", b / 1048576
        else                     printf "%.2f GB", b / 1073741824
    }'
}

# Apparent size of a single file in bytes; 0 when it is missing.
file_size() {
    stat -c %s -- "$1" 2>/dev/null || echo 0
}

fzf_with_usage() {
    local menu_id="$1"
    shift
    local usage_file="$CONFIG_DIR/usage_${menu_id}.txt"
    
    local tmp_input=$(mktemp)
    cat > "$tmp_input"
    
    local selected=$(
        if [ -f "$usage_file" ]; then
            awk -F'\t' '
                NR==FNR { usage[$2] = $1; next }
                {
                    key = $0
                    sub(/^[ \t]*[0-9]+\)[ \t]+/, "", key)
                    count = (key in usage) ? usage[key] : 0
                    print count "\t" FNR "\t" $0
                }
            ' "$usage_file" "$tmp_input" | sort -k1,1nr -k2,2n | cut -f3-
        else
            cat "$tmp_input"
        fi | fzf "$@"
    )
    
    rm -f "$tmp_input"
    
    if [ -n "$selected" ]; then
        local key="$selected"
        key=$(echo "$key" | sed -E 's/^[ \t]*[0-9]+\)[ \t]+//')
        
        export KEY="$key"
        if [ -f "$usage_file" ]; then
            awk -F'\t' '
                BEGIN { k = ENVIRON["KEY"] }
                $2 == k { print ($1 + 1) "\t" $2; found=1; next }
                { print $0 }
                END { if (!found) print "1\t" k }
            ' "$usage_file" > "${usage_file}.tmp" && mv "${usage_file}.tmp" "$usage_file"
        else
            echo -e "1\t$key" > "$usage_file"
        fi
        echo "$selected"
    fi
}

