scan_models() {
    echo "Scanning $PWD for .gguf models..."
    shopt -s nullglob
    mkdir -p "$modelstorage"
    for file in *.gguf; do
        [ ! -f "$file" ] && continue
        echo -e "\nFound model: $file"
        read -rp "Add this model? [Y/n] " choice
        if [[ "${choice:-Y}" =~ ^[Yy]$ ]]; then
            default_alias="${file%.*}"
            read -rp "Enter alias [$default_alias]: " alias
            alias="${alias:-$default_alias}"
            read -rp "Custom args: " custom_args
            
            read -rp "Does this model have a built-in MTP head? [y/N] " mtp_builtin
            if [[ "$mtp_builtin" =~ ^[Yy]$ ]]; then
                custom_args="--spec-type draft-mtp $custom_args"
            else
                read -rp "Does this model use a dedicated external draft file (Eagle3, MTP, DFlash, Simple)? [y/N] " mtp_dedicated
                if [[ "$mtp_dedicated" =~ ^[Yy]$ ]]; then
                    read -e -p "Path to draft file: " mtp_file
                    if [ -n "$mtp_file" ] && [ -f "$mtp_file" ]; then
                        read -rp "Action for draft file: [M]ove to storage, [K]eep in place? [M/k] " mtp_action
                        if [[ "${mtp_action:-M}" =~ ^[Mm]$ ]]; then
                            mv "$mtp_file" "$modelstorage/"
                            mtp_file="$modelstorage/$(basename "$mtp_file")"
                            echo "Moved draft file to storage."
                        else
                            mtp_file="$(readlink -f "$mtp_file")"
                        fi
                        
                        local d_type=$(echo -e "draft-simple\ndraft-eagle3\ndraft-mtp\ndraft-dflash\ndraft-dspark" | fzf --prompt="Select Draft Type > ")
                        [ -z "$d_type" ] && d_type="draft-simple"
                        
                        custom_args="-md $mtp_file --spec-type $d_type $custom_args"
                    else
                        echo "Warning: Draft file not found or not specified. Skipping."
                    fi
                fi
            fi

            read -rp "Action for main model: [M]ove to storage, [K]eep in place? [M/k] " action
            if [[ "${action:-M}" =~ ^[Mm]$ ]]; then
                mv "$file" "$modelstorage/"
                echo "${alias}|$modelstorage/$file|$custom_args" >> "$MODEL_LIST_FILE"
                echo "Moved and added: $alias"
            else
                local abs_path="$PWD/$file"
                echo "${alias}|$abs_path|$custom_args" >> "$MODEL_LIST_FILE"
                echo "Kept in place and added: $alias"
            fi
        fi
    done
}



scan_prompts() {
    echo "Scanning $PWD for .txt prompt files..."
    shopt -s nullglob
    mkdir -p "$PROMPTS_DIR"
    for file in *.txt; do
        echo -e "\nFound prompt file: $file"
        read -rp "Add this prompt? [Y/n] " choice
        if [[ "${choice:-Y}" =~ ^[Yy]$ ]]; then
            default_alias="${file%.*}"
            read -rp "Enter prompt alias [$default_alias]: " alias
            alias="${alias:-$default_alias}"
            cp "$file" "$PROMPTS_DIR/"
            echo "${alias}|$PROMPTS_DIR/$file|" >> "$PROMPT_LIST_FILE"
            echo "Added prompt: $alias"
        fi
    done
}

delete_model() {
    [ ! -f "$MODEL_LIST_FILE" ] && { echo "No models saved in $MODEL_LIST_FILE"; exit 1; }

    # One pass over the list: per-model size, running total. Then a second pass
    # over model storage for .gguf files the list has forgotten - they still eat
    # the disk, but cannot be picked (no index to delete).
    local rows="" total=0 n=0 untracked=0
    local alias mpath margs psize
    local tracked_tmp; tracked_tmp=$(mktemp)
    while IFS='|' read -r alias mpath margs; do
        [ -z "$alias" ] && continue
        printf '%s\n' "$mpath" >> "$tracked_tmp"
        psize=$(file_size "$mpath")
        total=$((total + psize))
        n=$((n + 1))
        rows+="$(printf '%2d) %9s  %-22s %s\n' "$n" "$(human_size "$psize")" "$alias" "$mpath")"$'\n'
    done < "$MODEL_LIST_FILE"

    shopt -s nullglob
    local f
    for f in "$modelstorage"/*.gguf; do
        grep -Fqx -- "$f" "$tracked_tmp" && continue
        psize=$(file_size "$f")
        untracked=$((untracked + psize))
        rows+="$(printf '%2s) %9s  %-22s %s\n' "-" "$(human_size "$psize")" "${f##*/}" "$f")"$'\n'
    done
    rm -f "$tracked_tmp"

    echo "Model storage: $modelstorage"
    printf '%s' "$rows"
    printf '\n  total: %s in %d model(s)' "$(human_size "$total")" "$n"
    [ "$untracked" -gt 0 ] && printf ' + %s untracked' "$(human_size "$untracked")"
    printf '\n'

    # No terminal: the report is the whole output.
    [ -t 0 ] || return 0

    local header="total $(human_size "$total") in $n model(s)"
    local selected
    selected=$(printf '%s' "$rows" | fzf --prompt="Select model to delete > " --header "$header") || return 0
    [ -z "$selected" ] && return 0

    local index; index=$(echo "$selected" | awk '{print $1}' | tr -d ')')
    [[ "$index" =~ ^[0-9]+$ ]] || { echo "Not in $MODEL_LIST_FILE - delete the file by hand."; return; }
    IFS='|' read -r alias mpath margs <<< "$(sed "${index}q;d" "$MODEL_LIST_FILE")"

    local freed; freed=$(file_size "$mpath")
    [ -f "$mpath" ] || echo "Warning: $mpath is already gone."
    read -rp "Delete $mpath ($(human_size "$freed"))? [y/N] " confirm
    if [[ "${confirm:-N}" =~ ^[Yy]$ ]]; then
        rm -f -- "$mpath" && echo "Freed $(human_size "$freed")"
        sed -i "${index}d" "$MODEL_LIST_FILE"
    fi
}

delete_prompt() {
    [ ! -f "$PROMPT_LIST_FILE" ] && exit 1
    local selected=$(cat "$PROMPT_LIST_FILE" | awk -F'|' '{printf "%2d) %-20s %s\n", NR, $1, $2}' | fzf --prompt="Select prompt to delete > ")
    [ -z "$selected" ] && return
    
    local index=$(echo "$selected" | awk '{print $1}' | tr -d ')')
    sed -i "${index}d" "$PROMPT_LIST_FILE"
}

select_prompt() {
    [ ! -f "$PROMPT_LIST_FILE" ] && selected_prompt="" && return 0
    local options="0) None\n$(cat "$PROMPT_LIST_FILE" | awk -F'|' '{printf "%2d) %s\n", NR, $1}')"
    local selected=$(echo -e "$options" | fzf_with_usage prompts --prompt="Select Prompt > ")
    [ -z "$selected" ] && selected_prompt="" && return 0
    
    local index=$(echo "$selected" | awk '{print $1}' | tr -d ')')
    if [ "$index" -eq 0 ]; then
        selected_prompt=""
    else
        IFS='|' read -r _ selected_prompt _ <<< "$(sed "${index}q;d" "$PROMPT_LIST_FILE")"
    fi
}

# =============================================================================
# Launchers
# =============================================================================
# =============================================================================
# Patch handling
# =============================================================================
# One file in $PATCH_DIR = one commit to the llama.cpp tree. All of them are
# re-applied automatically after -i / -u / -C (git pull + reset wipe them),
# so local engine changes survive upgrades instead of silently disappearing.

patch_already_applied() {
    local pf="$1"
    [ -d "$LLAMA_DIR/.git" ] || return 1
    git -C "$LLAMA_DIR" apply --reverse --check "$pf" >/dev/null 2>&1
}

patch_apply_file() {
    local pf="$1" name
    name=$(basename "$pf")

    if [ ! -f "$pf" ]; then
        echo -e "${C_RED}[Patch]${C_RST} $name: file not found, skip"
        return 1
    fi
    if patch_already_applied "$pf"; then
        echo -e "${C_YLW}[Patch]${C_RST} $name: already applied, skip"
        return 0
    fi
    # dry-run first: never half-apply or clobber patches that are already in
    if git -C "$LLAMA_DIR" apply -3 --whitespace=nowarn --check "$pf" >/dev/null 2>&1; then
        git -C "$LLAMA_DIR" apply -3 --whitespace=nowarn "$pf" >/dev/null 2>&1 \
            && { echo -e "${C_GRN}[Patch]${C_RST} $name: applied (git apply)"; return 0; }
    fi
    if (cd "$LLAMA_DIR" && patch -p1 --forward --dry-run --silent < "$pf" >/dev/null 2>&1); then
        (cd "$LLAMA_DIR" && patch -p1 --forward --silent < "$pf" >/dev/null 2>&1) \
            && { echo -e "${C_GRN}[Patch]${C_RST} $name: applied (patch -p1)"; return 0; }
    fi
    # do not touch other local changes: only sweep rejects this attempt could make
    find "$LLAMA_DIR" -maxdepth 5 \( -name '*.orig' -o -name '*.rej' \) -newermt '-3 minutes' -delete 2>/dev/null || true
    echo -e "${C_RED}[Patch]${C_RST} $name: FAILED, skipped (upstream changed? fix the patch)"
    return 1
}

apply_all_patches() {
    [ -d "$PATCH_DIR" ] || return 0
    local pf bad=0
    shopt -s nullglob
    for pf in "$PATCH_DIR"/*.patch; do
        patch_apply_file "$pf" || bad=$((bad+1))
    done
    shopt -u nullglob
    [ "$bad" -gt 0 ] && echo -e "${C_RED}[Patch]${C_RST} $bad patch(es) failed, continuing unpatched"
    return 0
}

apply_patch() {
    local patch_file="${1:-}"

    if [ ! -d "$LLAMA_DIR" ]; then
        echo -e "${C_RED}Error:${C_RST} backend dir not found: $LLAMA_DIR (run: llm -i)"
        exit 1
    fi

    # no arg -> apply every patch from the patches dir
    if [ -z "$patch_file" ]; then
        if [ ! -d "$PATCH_DIR" ]; then
            echo -e "${C_YLW}[Patch]${C_RST} $PATCH_DIR does not exist, no patches to apply"
            return 0
        fi
        echo "[Patch] Applying all patches from $PATCH_DIR -> $LLAMA_DIR"
        apply_all_patches
    else
        # accept either a path or a bare filename from PATCH_DIR
        if [ ! -f "$patch_file" ] && [ -f "$PATCH_DIR/$(basename "$patch_file")" ]; then
            patch_file="$PATCH_DIR/$(basename "$patch_file")"
        fi
        if [ ! -f "$patch_file" ]; then
            echo -e "${C_RED}Error:${C_RST} patch file '$patch_file' not found"
            exit 1
        fi
        patch_file="$(realpath "$patch_file")"
        echo "[Patch] Applying $patch_file -> $LLAMA_DIR"
        if ! patch_apply_file "$patch_file"; then
            exit 1
        fi
    fi

    # recompile so the patch actually lands in the binaries
    local ans="y"
    if [ -t 0 ]; then
        read -r -p "Recompile $ACTIVE_BACKEND now? [Y/n] " ans
    fi
    case "$ans" in
        [nN]*) echo "Skipped. Run: llm -c" ;;
        *)     compile_llm_core ;;
    esac
    exit 0
}

