print_llama_help() {
    if [ -x "$LLAMA_DIR/build/bin/llama-server" ]; then
        "$LLAMA_DIR/build/bin/llama-server" --help 2>&1 | ${PAGER:-less -R}
    else
        echo "Error: llama-server binary not found at $LLAMA_DIR/build/bin/llama-server"
        return 1
    fi
}

cleanup() {
    if [ -n "$llama_pid" ]; then
        echo -e "\n[LLM] Cleaning up server (PID: $llama_pid)..."
        kill -TERM -"$llama_pid" 2>/dev/null || kill "$llama_pid" 2>/dev/null || true
        for i in {1..10}; do
            if ! kill -0 "$llama_pid" 2>/dev/null; then break; fi
            sleep 0.5
        done
        kill -9 "$llama_pid" 2>/dev/null || true
    fi
}

trap cleanup EXIT SIGINT SIGTERM

ensure_repo() {
    local dir=$1
    local repo=$2
    if [ ! -d "$dir" ]; then
        echo "Cloning $repo into $dir..."
        git clone --depth 1 "$repo" "$dir"
    fi
}

run_pinned() {
    # Dynamic pin: $PIN_CPUS = one thread per physical core, SMT siblings unused.
    # exec keeps PID stable so kill $llama_pid works.
    if command -v taskset &> /dev/null && [ -n "$PIN_CPUS" ]; then
        exec taskset -c "$PIN_CPUS" "$@"
    else
        exec "$@"
    fi
}

probe_remote_ctx() {
    local url="$1"
    local key="$2"
    local props_url="${url%/v1}/props"
    local server_ctx=$(curl -s --max-time 2 -H "Authorization: Bearer $key" "$props_url" | sed -n 's/.*"n_ctx"[[:space:]]*:[[:space:]]*\([0-9]\+\).*/\1/p' | head -n 1)
    if [ -n "$server_ctx" ] && [ "$server_ctx" -gt 0 ]; then
        export SELECTED_CTX="$server_ctx"
    fi
}

start_llama_server() {
    local port=${1:-$DEFAULT_PORT}
    echo "Starting llama-server on port $port..."
    
    if [ ! -x "$LLAMA_DIR/build/bin/llama-server" ]; then
        echo "Error: llama-server binary not found!"
        echo "Please compile it first by running: llm -cl"
        exit 1
    fi
    
    local extra_args=()
    [ -n "$selected_alias" ] && extra_args=("--alias" "$selected_alias")
    
    _srv_args="${extra_args[*]} $SERVER_ARGS $PROFILE_SERVER_ARGS $final_args --port $port"
    run_pinned "$LLAMA_DIR/build/bin/llama-server" -m "$selected_path" $_srv_args > "$BASE_DIR/llama-server.log" 2>&1 &
    llama_pid=$!
    
    # Readiness: match the field, not the whole object - ik_llama.cpp answers
    # {"status":"ok","slots_idle":N,"slots_processing":N} while mainline answers
    # {"status":"ok"}, so the old literal object match never fired on ik builds.
    local wait_s="${LLM_READY_TIMEOUT:-180}" ready=0
    echo -n "Waiting for server to be ready (up to ${wait_s}s)..."
    for ((i = 0; i < wait_s; i++)); do
        if curl -s -m 2 "http://127.0.0.1:$port/health" | grep -q '"status":"ok"'; then
            echo " Ready!"
            ready=1
            break
        fi
        if ! kill -0 "$llama_pid" 2>/dev/null; then
            echo -e "\nServer crashed! Last lines of $BASE_DIR/llama-server.log:"
            tail -n 15 "$BASE_DIR/llama-server.log" 2>/dev/null
            exit 1
        fi
        echo -n "."
        sleep 1
    done
    if [ "$ready" = "0" ]; then
        echo -e "\nServer not ready after ${wait_s}s (set LLM_READY_TIMEOUT to wait longer)."
        echo "Last lines of $BASE_DIR/llama-server.log:"
        tail -n 15 "$BASE_DIR/llama-server.log" 2>/dev/null
        exit 1
    fi
    
    # Export common AI environment variables for downstream clients
    export OPENAI_API_BASE_URL="http://localhost:$port/v1"
    export OPENAI_API_BASE="http://localhost:$port/v1"
    export OPENAI_API_KEY="$API_KEY"
    
    probe_remote_ctx "http://localhost:$port/v1" "$API_KEY"
}

