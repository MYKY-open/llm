SCRIPT_PATH="$(readlink -f "$BASH_SOURCE")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"

# Main installation directory
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
BASE_DIR="${MYKYSW_DIR:-$HOME/mykysw}"

# Lists / Config Directory
CONFIG_DIR="$BASE_DIR/config"
mkdir -p "$CONFIG_DIR"
ACTIVE_BACKEND_FILE="$CONFIG_DIR/active_backend.txt"
ACTIVE_BACKEND="mainline"
if [ -f "$ACTIVE_BACKEND_FILE" ]; then
    _saved_backend=$(cat "$ACTIVE_BACKEND_FILE")
    case "$_saved_backend" in
        mainline|ikllamacpp) ACTIVE_BACKEND="$_saved_backend" ;;
        "") : ;;
        # stale config (e.g. an old backend name): fall back and self-heal the file
        *) echo "[LLM] Unknown backend '$_saved_backend' in $ACTIVE_BACKEND_FILE - falling back to mainline." >&2
           echo "mainline" > "$ACTIVE_BACKEND_FILE" ;;
    esac
fi

# mainline (upstream llama.cpp + this script's defaults) vs ikllamacpp (ik_llama.cpp
# CPU fork). Their flag sets are NOT interchangeable: ik_llama.cpp rejects
# --load-mode/--lazy-mode/--poll/--prio/--cpu-strict*, -nr, --sleep-idle-seconds and
# --spec-draft-n-max outright. Everything emitted below is checked against each
# build's `llama-server --help` (see build_ram_args, build_spec_args, run_model).
is_ik_backend() { [ "$ACTIVE_BACKEND" = "ikllamacpp" ]; }

# Speculative decoding flags. Same mechanisms, different spelling:
#   mainline: --spec-type draft-mtp --spec-draft-n-max N --spec-draft-n-min M
#   ik      : --spec-type mtp:n_max=N,n_min=M
# The old S_SPEC_DM knob (--spec-dm-controller) is in neither build -> dropped.
map_spec_type_ik() {
    case "$1" in
        draft-simple) echo draft ;;
        draft-mtp)    echo mtp ;;
        draft-dflash) echo dflash ;;
        draft-dspark) echo dspark ;;
        draft-eagle3) echo "" ;;   # no ik_llama.cpp equivalent
        *)            echo "$1" ;;
    esac
}

build_spec_args() {
    case "$S_SPEC_TYPE" in ""|none) return 0 ;; esac
    local t="$S_SPEC_TYPE"
    if is_ik_backend; then
        t=$(map_spec_type_ik "$t")
        if [ -z "$t" ]; then
            echo "[LLM] --spec-type $S_SPEC_TYPE has no ik_llama.cpp equivalent - not passed." >&2
            return 0
        fi
        if [ "$S_SPEC_N_MAX" != "0" ]; then
            echo "--spec-type $t:n_max=$S_SPEC_N_MAX,n_min=${S_SPEC_N_MIN:-0} "
        else
            echo "--spec-type $t "
        fi
    else
        echo "--spec-type $t "
        [ "$S_SPEC_N_MAX" != "0" ] && echo "--spec-draft-n-max $S_SPEC_N_MAX --spec-draft-n-min $S_SPEC_N_MIN "
    fi
}

# Per-model args (llm_models.txt field 3) and CLI args are written in mainline
# spelling. Rewrite the spec-type names when an ik build is active. Idempotent.
translate_spec_args_ik() {
    is_ik_backend || { echo "$1"; return 0; }
    sed -E 's/--spec-type draft-simple\b/--spec-type draft/g;
            s/--spec-type draft-mtp\b/--spec-type mtp/g;
            s/--spec-type draft-dflash\b/--spec-type dflash/g;
            s/--spec-type draft-dspark\b/--spec-type dspark/g' <<<"$1"
}

# Base directories
LLAMA_DIR="$BASE_DIR/llama.cpp-$ACTIVE_BACKEND"
# Local patches for the llama.cpp backend: every *.patch here is applied on -i/-u and via -p
PATCH_DIR="${PATCH_DIR:-$SCRIPT_DIR/patches}"
modelstorage="$BASE_DIR/modelstorage"
PROMPTS_DIR="$BASE_DIR/prompts"

# UI Repositories
SILLYTAVERN_DIR="$BASE_DIR/sillytavern"
SILLYTAVERN_REPO="https://github.com/SillyTavern/SillyTavern.git"
DEEPSEEK_DIR="$BASE_DIR/deepseek-harness"
DEEPSEEK_REPO="https://github.com/deepseek-ai/deepseek-harness.git"
OOBABOOGA_DIR="$BASE_DIR/text-generation-webui"
OOBABOOGA_REPO="https://github.com/oobabooga/text-generation-webui.git"
ODYSSEUS_DIR="$BASE_DIR/odysseus"
ODYSSEUS_REPO="https://github.com/pewdiepie-archdaemon/odysseus.git"
HERMES_DIR="$BASE_DIR/hermes"
HERMES_REPO="https://github.com/NousResearch/hermes-agent.git"
PI_DIR="$BASE_DIR/pi"
LITTLECODER_DIR="$BASE_DIR/little-coder"
MYKYAGENT_DIR="${MYKYAGENT_DIR:-$BASE_DIR/mykyagent}"
MYKYAGENT_REPO="https://github.com/MYKY-open/mykyagent.git"
OPENCODE_DIR="$BASE_DIR/opencode"
CODEHAMR_DIR="$BASE_DIR/codehamr"

# System Resources - dynamic, works on any core count (phone 4c .. desktop 16c)
#
# Physical cores + a pin list holding exactly ONE cpu per physical core.
# Source of truth = kernel topology (thread_siblings_list), the same data the
# scheduler uses. Handles x86 SMT (0-1 = one core), ARM without SMT (every cpu
# is its own core) and degenerate topologies (big.LITTLE phones / some VMs where
# every cluster reports core_id 0) that collapse lscpu (Core,Socket) pair-counting
# down to a single "core". Sets: PHYSICAL_CORES, PHYS_PIN (ascending).
detect_phys_cpus() {
    local d cpu grp f first out="" seen=" "
    for d in /sys/devices/system/cpu/cpu[0-9]*/topology/thread_siblings_list; do
        [ -e "$d" ] || continue
        cpu=${d#/sys/devices/system/cpu/cpu}; cpu=${cpu%%/*}
        # skip offline cpus (cpu0 has no online file, it is always on)
        if [ -e "/sys/devices/system/cpu/cpu$cpu/online" ] &&
           [ "$(cat "/sys/devices/system/cpu/cpu$cpu/online" 2>/dev/null)" = 0 ]; then
            continue
        fi
        grp=$(cat "$d" 2>/dev/null) || continue
        [ -n "$grp" ] || continue
        case "$seen" in *" $grp "*) continue ;; esac   # same sibling group = same core
        seen="$seen$grp "
        first=""
        for f in ${grp//,/ }; do
            f=${f%%-*}                                  # "0-1" -> 0
            if [ -z "$first" ] || [ "$f" -lt "$first" ]; then first=$f; fi
        done
        [ -n "$first" ] && out="$out $first"
    done
    [ -n "$out" ] || return 1
    PHYSICAL_CORES=$(printf '%s\n' $out | wc -l)
    PHYS_PIN=$(printf '%s\n' $out | sort -n | paste -sd, -)
    return 0
}

PHYSICAL_CORES=""; PHYS_PIN=""
if ! detect_phys_cpus; then
    # fallback 1: lscpu pair counting (sysfs topology missing/unreadable)
    if command -v lscpu &> /dev/null; then
        PHYSICAL_CORES=$(lscpu -b -p=Core,Socket 2>/dev/null | grep -v '^#' | sort -u | wc -l)
        PHYS_PIN=$(lscpu -b -p=CPU,Core,Socket 2>/dev/null | grep -v '^#' | awk -F, '{if (!seen[$2","$3]++) print $1}' | sort -n | paste -sd, -)
    fi
fi
if [ -z "$PHYS_PIN" ] || [ -z "$PHYSICAL_CORES" ] || [ "$PHYSICAL_CORES" -lt 1 ] 2>/dev/null; then
    # fallback 2: no topology info at all - assume no SMT
    PHYSICAL_CORES=$(nproc --all 2>/dev/null || echo 4)
    PHYS_PIN=$(seq -s, 0 $((PHYSICAL_CORES - 1)))
fi
# sanity clamp
[ "$PHYSICAL_CORES" -lt 2 ] 2>/dev/null && PHYSICAL_CORES=2

# Build on ALL logical cpus. "nproc --all" ignores OMP_NUM_THREADS / OMP_THREAD_LIMIT;
# bare nproc silently clamps to them (they are exported below) and halves compiles.
BUILD_THREADS=$(nproc --all 2>/dev/null || nproc 2>/dev/null || echo "$PHYSICAL_CORES")
BUILD_THREADS=${BUILD_THREADS:-$PHYSICAL_CORES}
# Generation: one thread per PHYSICAL core, each pinned to its own core - no SMT
# sibling interference, no cross-core migration. gen threads cover gen and batch.
GEN_THREADS=$PHYSICAL_CORES
[ "$GEN_THREADS" -lt 2 ] && GEN_THREADS=2
export BLIS_NUM_THREADS=$GEN_THREADS
export OMP_NUM_THREADS=$GEN_THREADS
export OMP_WAIT_POLICY=PASSIVE
export GOMP_SPINCOUNT=0
# PIN_CPUS: generation cpus only - first GEN_THREADS entries of PHYS_PIN, i.e. one
# cpu per physical core, SMT siblings of those cores are never used for generation.
PIN_CPUS=$(printf '%s' "$PHYS_PIN" | tr ',' '\n' | head -n "$GEN_THREADS" | paste -sd, -)
if [ -z "$PIN_CPUS" ]; then
    # fallback: 0..GEN-1
    PIN_CPUS=$(seq -s, 0 $((GEN_THREADS - 1)))
fi

# Configuration (USER-EDITABLE placeholders — change to fit your machine)
EDITOR=kate
SUDO=sudo
API_KEY="cannotguess" # placeholder default, edit me; can also come from env
# Default llama-server port - matches upstream llama.cpp default (9931).
# Override per-run/call: LLM_PORT=1234 llm
DEFAULT_PORT="${LLM_PORT:-9931}"
CMAKE_COMPILER_ARGS=()
BUILDOPT=()
# Opt-in GPU build: LLM_CUDA=1 llm -i / -c. Both backends compile via GGML_CUDA.
if [ "${LLM_CUDA:-0}" = "1" ]; then
    BUILDOPT+=(-DGGML_CUDA=ON)
fi

FORCE_RESET=0
for arg in "$@"; do
    if [[ "$arg" == "-f" || "$arg" == "--force" ]]; then
        FORCE_RESET=1
    fi
done

# Optimized defaults with dynamic speculative decoding cache
mkdir -p "$BASE_DIR/cache"

# RAM knob defaults. --cache-ram 8192 and -ctxcp 32 are also the llama-server
# defaults (see --help), so at those values no flag is passed at all. Idle unload
# is this script's own policy, not an upstream default.
# Repacking copies every repackable weight into an anonymous buffer at load. It only
# pays off with AVX512 kernels; on AVX2 it costs the model size in RAM a second time
# with no speedup. Builds use GGML_NATIVE, so host flags == compiled kernels.
if grep -qw avx512f /proc/cpuinfo 2>/dev/null; then
    RAM_DEF_NO_REPACK=0
else
    RAM_DEF_NO_REPACK=1
fi
RAM_DEF_CACHE_MIB=8192
RAM_DEF_CTXCP=32
RAM_DEF_IDLE_SEC=600

SETTINGS_FILE="$CONFIG_DIR/llm_settings.conf"
if [ -f "$SETTINGS_FILE" ]; then
    source "$SETTINGS_FILE"
else
    S_TEMP="0.9"
    S_TOP_P="1.0"
    S_TOP_K="0"
    S_MIN_P="0.05"
    S_XTC_PROB="0.0"
    S_XTC_THRESH="0.1"
    S_TFS="1.0"
    S_TYPICAL="1.0"
    S_MIROSTAT="0"
    S_MIROSTAT_LR="0.1"
    S_MIROSTAT_ENT="5.0"
    S_PRESENCE="0.0"
    S_FREQUENCY="0.0"
    S_PENALTY_REPEAT="1.0"
    S_PENALTY_LAST_N="64"
    S_SPEC_TYPE="none"
    S_SPEC_N_MAX="0"
    S_SPEC_N_MIN="0"
    S_CTX_SIZE="0"
    S_DRAFT_MODEL=""
    
    cat > "$SETTINGS_FILE" <<EOF
S_TEMP="$S_TEMP"
S_TOP_P="$S_TOP_P"
S_TOP_K="$S_TOP_K"
S_MIN_P="$S_MIN_P"
S_XTC_PROB="$S_XTC_PROB"
S_XTC_THRESH="$S_XTC_THRESH"
S_TFS="$S_TFS"
S_TYPICAL="$S_TYPICAL"
S_MIROSTAT="$S_MIROSTAT"
S_MIROSTAT_LR="$S_MIROSTAT_LR"
S_MIROSTAT_ENT="$S_MIROSTAT_ENT"
S_PRESENCE="$S_PRESENCE"
S_FREQUENCY="$S_FREQUENCY"
S_PENALTY_REPEAT="$S_PENALTY_REPEAT"
S_PENALTY_LAST_N="$S_PENALTY_LAST_N"
S_SPEC_TYPE="$S_SPEC_TYPE"
S_SPEC_N_MAX="$S_SPEC_N_MAX"
S_SPEC_N_MIN="$S_SPEC_N_MIN"
S_CTX_SIZE="$S_CTX_SIZE"
S_DRAFT_MODEL="$S_DRAFT_MODEL"
RAM_NO_REPACK="$RAM_DEF_NO_REPACK"
RAM_CACHE_MIB="$RAM_DEF_CACHE_MIB"
RAM_CTXCP="$RAM_DEF_CTXCP"
RAM_IDLE_SEC="$RAM_DEF_IDLE_SEC"
EOF
fi

: "${S_XTC_PROB:=0.0}"
: "${S_XTC_THRESH:=0.1}"
: "${RAM_NO_REPACK:=$RAM_DEF_NO_REPACK}"
: "${RAM_CACHE_MIB:=$RAM_DEF_CACHE_MIB}"
: "${RAM_CTXCP:=$RAM_DEF_CTXCP}"
: "${RAM_IDLE_SEC:=$RAM_DEF_IDLE_SEC}"
case "$RAM_NO_REPACK" in 0|1) ;; *) RAM_NO_REPACK=$RAM_DEF_NO_REPACK ;; esac
[[ "$RAM_CACHE_MIB" =~ ^-?[0-9]+$ ]] || RAM_CACHE_MIB=$RAM_DEF_CACHE_MIB
[[ "$RAM_CTXCP" =~ ^[0-9]+$ ]] || RAM_CTXCP=$RAM_DEF_CTXCP
# llama-server rejects 0 or < -1: "cannot be 0 or less than -1" (-1 = never sleep).
[[ "$RAM_IDLE_SEC" =~ ^-?[0-9]+$ ]] && [ "$RAM_IDLE_SEC" -ge -1 ] && [ "$RAM_IDLE_SEC" != "0" ] \
    || RAM_IDLE_SEC=$RAM_DEF_IDLE_SEC

if [ "$S_MIROSTAT" != "0" ]; then
    LLM_DEFAULTS="--temp 1.0 "
else
    LLM_DEFAULTS="--temp $S_TEMP "
fi
LLM_DEFAULTS+="--top-p $S_TOP_P --top-k $S_TOP_K --min-p $S_MIN_P "
[ -n "$S_XTC_PROB" ] && [ "$S_XTC_PROB" != "0.0" ] && [ "$S_XTC_PROB" != "0" ] && LLM_DEFAULTS+="--xtc-probability $S_XTC_PROB --xtc-threshold $S_XTC_THRESH "
LLM_DEFAULTS+="--typical $S_TYPICAL --mirostat $S_MIROSTAT --mirostat-lr $S_MIROSTAT_LR --mirostat-ent $S_MIROSTAT_ENT "
LLM_DEFAULTS+="--presence-penalty $S_PRESENCE --frequency-penalty $S_FREQUENCY --repeat-penalty $S_PENALTY_REPEAT --repeat-last-n $S_PENALTY_LAST_N "
_spec_args=$(build_spec_args)
LLM_DEFAULTS+="$_spec_args"
if [ "$S_CTX_SIZE" != "0" ] && [ -n "$S_CTX_SIZE" ]; then
    LLM_DEFAULTS+="-c $S_CTX_SIZE "
fi
if [ -n "$S_DRAFT_MODEL" ] && [ "$S_DRAFT_MODEL" != '""' ]; then
    LLM_DEFAULTS+="-md $S_DRAFT_MODEL "
fi


set_backend_defaults() {
    case "$ACTIVE_BACKEND" in
        ikllamacpp)
            LLAMA_REPO="https://github.com/ikawrakow/ik_llama.cpp.git"
            # ik_llama.cpp: CPU-specialised fork, own flag set. Do not copy mainline
            # flags here - it aborts with "unknown argument".
            #   -rtr   run-time repack - OFF by default here: src/llama-model-loader.cpp
            #          allocates an owned CPU buffer and read_raw()s every tensor that has
            #          an interleaved variant into it, so weights exist twice (mmap page
            #          cache + anonymous copy). Measured: +0.26 GiB on LFM3-1.7B Q6_K,
            #          +0.00 on ling Q4_K_M, and no tg gain on AVX2 (22.65 vs 22.55 t/s).
            #          Turn it back on per machine with IK_TUNING="-rtr ...".
            #   -mqkv  merge Q,K,V at load (no extra RSS measured)
            #   --swa-compress  sliding-window layers get KV at window size, not n_ctx
            #          (no-op for non-SWA models; the only cache-size knob ik adds)
            #   -amb   attention max batch (upstream default 256). Measured here with
            #          llama-bench on MiniCPM-35B-A3B (MoE) and LFM3-1.7B: -rtr -mqkv
            #          was equal or better (tg +3..5%, pp +0..5%), 512 was the best
            #          -amb of 64/128/512 and never worse than 256. Deltas are inside
            #          CPU noise, so nothing here can regress a model - and the set is
            #          overridable: IK_TUNING="..." in llm_settings.conf.
            IK_TUNING="${IK_TUNING:--mqkv -amb 512 --swa-compress}"
            # -ub 512, not 1024: on a CPU build the compute buffer scales with ubatch
            # (measured 310 MiB @512 vs 620 MiB @1024 on ling-3.0-tiny) and the bench
            # delta between them was inside noise, so the smaller ub is free RAM.
            DEFAULT_MODEL_ARGS="$IK_TUNING --no-warmup -fa on -ctk q8_0 -ctv q8_0 -t $GEN_THREADS -tb $GEN_THREADS -ub 512 $LLM_DEFAULTS"
            ;;
        *)
            LLAMA_REPO="https://github.com/ggerganov/llama.cpp.git"
            # Mainline llama.cpp defaults. CPU-only (no Vulkan copy = fast load), mmap+lazy, no spin.
            DEFAULT_MODEL_ARGS="--poll 0 --poll-batch 0 --no-warmup -fa on -ctk q8_0 -ctv q8_0 --load-mode mmap --lazy-mode on --cpu-strict 1 --cpu-strict-batch 1 --prio -1 -t $GEN_THREADS -tb $GEN_THREADS -ub 1024 $LLM_DEFAULTS"
            ;;
    esac
}
set_backend_defaults

# Server-mode extra flags (applied on top of defaults for server modes)
# --slot-save-path only enables manual /slots/save API, no auto-save.
# --jinja explicit on (default on anyway). --parallel 1 keeps RAM flat.
SERVER_ARGS="--slot-save-path $BASE_DIR/cache --jinja --parallel 1"

# RAM knobs -> llama.cpp flags, set via `llm -s` -> Memory / RAM. No -c here on
# purpose: context is model-specific and belongs in llm_models.txt field 3.
# Both vars are prepended to the model/CLI args, so anything the user sets later
# still wins (llama.cpp parses last-wins) - no duplicate-flag detection needed.
build_ram_args() {
    PROFILE_ARGS=""
    PROFILE_SERVER_ARGS=""

    if is_ik_backend; then
        # ik_llama.cpp has no -nr (it repacks at runtime via -rtr) and no
        # --sleep-idle-seconds. It does honour --cache-ram and --ctx-checkpoints.
        [ "$RAM_CACHE_MIB" != "$RAM_DEF_CACHE_MIB" ] && PROFILE_SERVER_ARGS+="--cache-ram $RAM_CACHE_MIB "
        [ "$RAM_CTXCP" != "$RAM_DEF_CTXCP" ] && PROFILE_SERVER_ARGS+="--ctx-checkpoints $RAM_CTXCP "
    else
        [ "$RAM_NO_REPACK" = "1" ] && PROFILE_ARGS="-nr"
        [ "$RAM_CACHE_MIB" != "$RAM_DEF_CACHE_MIB" ] && PROFILE_SERVER_ARGS+="--cache-ram $RAM_CACHE_MIB "
        # --ctx-checkpoints is the long form of -ctxcp; both builds accept it.
        [ "$RAM_CTXCP" != "$RAM_DEF_CTXCP" ] && PROFILE_SERVER_ARGS+="--ctx-checkpoints $RAM_CTXCP "
        PROFILE_SERVER_ARGS+="--sleep-idle-seconds $RAM_IDLE_SEC "
    fi
}

# ANSI colors for engine/patch messages (print_help has its own locals)
C_RST=$'\033[0m'
C_GRN=$'\033[32m'
C_RED=$'\033[31m'
C_YLW=$'\033[33m'

# Lists / Config Directory
CONFIG_DIR="$BASE_DIR/config"
mkdir -p "$CONFIG_DIR"
MODEL_LIST_FILE="$CONFIG_DIR/llm_models.txt"
PROMPT_LIST_FILE="$CONFIG_DIR/llm_prompts.txt"

# Migrate old lists if they exist
[ -f "$BASE_DIR/.llm_models" ] && mv "$BASE_DIR/.llm_models" "$MODEL_LIST_FILE"
[ -f "$BASE_DIR/.llm_prompts" ] && mv "$BASE_DIR/.llm_prompts" "$PROMPT_LIST_FILE"

export FZF_DEFAULT_OPTS="--color=dark,bg+:-1,fg:gray,fg+:white,prompt:blue,pointer:red,marker:yellow"

# Auto-Offload VRAM Limit (in Megabytes). Set to 0 to disable.

# Base compiler flags (-O3 already comes from CMAKE_BUILD_TYPE=Release)
# -fno-plt             : skip PLT trampolines (faster shared-lib calls)
# -fipa-pta            : inter-procedural points-to analysis (GCC-only)
