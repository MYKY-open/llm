upgrade_llm_core() {
    if [ -d "$LLAMA_DIR" ]; then
        (
            echo "Upgrading llama.cpp ($ACTIVE_BACKEND)..."
            cd "$LLAMA_DIR" || exit 1
            if [ "$FORCE_RESET" == "1" ]; then
                git reset --hard HEAD
                git clean -fd
                git pull
            else
                git pull --rebase --autostash
            fi
            git submodule update --init --recursive --depth 1
            apply_all_patches
            compile_llm_core
        )
    else
        echo "llama.cpp ($ACTIVE_BACKEND) not installed - skipping local engine upgrade."
        echo "This is fine for API/cloud users. Install a local engine anytime with: llm -i"
    fi

    if [ -d "$SCRIPT_DIR/.git" ]; then
        echo "Upgrading llm orchestrator..."
        (cd "$SCRIPT_DIR" && git pull --rebase --autostash)
    fi

    [ -d "$SILLYTAVERN_DIR" ] && (cd "$SILLYTAVERN_DIR" && git pull)
    [ -d "$DEEPSEEK_DIR" ] && (cd "$DEEPSEEK_DIR" && git pull)
    [ -d "$OOBABOOGA_DIR" ] && (cd "$OOBABOOGA_DIR" && git pull)
    [ -d "$ODYSSEUS_DIR" ] && (cd "$ODYSSEUS_DIR" && git pull)
    [ -x "$CODEHAMR_DIR/codehamr" ] && install_codehamr
    [ -x "$HOME/.opencode/bin/opencode" ] && install_opencode
    [ -d "$PI_DIR" ] && install_pi
    [ -d "$LITTLECODER_DIR" ] && (cd "$LITTLECODER_DIR" && git pull --rebase --autostash)
    [ -d "$MYKYAGENT_DIR" ] && (cd "$MYKYAGENT_DIR" && git pull --rebase --autostash)
}

upgrade_all() {
    upgrade_llm_core
}

configure_llm() {
    echo "Preparing llama.cpp ($ACTIVE_BACKEND) for configuration..."
    ensure_repo "$LLAMA_DIR" "$LLAMA_REPO"
    cd "$LLAMA_DIR" || exit
    git submodule update --init --recursive --depth 1
    apply_all_patches
    setup_compiler
    if [ ! -f "build/CMakeCache.txt" ]; then
        run_cmake -B build "${CMAKE_COMPILER_ARGS[@]}" -DCMAKE_C_FLAGS="$LLAMA_CFLAGS" -DCMAKE_CXX_FLAGS="$LLAMA_CFLAGS" "${BUILDOPT[@]}"
    fi
    ccmake build
}

