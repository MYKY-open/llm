configure_ram_settings() {
    local v
    while true; do
        local repack_state="repack"
        [ "$RAM_NO_REPACK" = "1" ] && repack_state="no-repack"
        local choice=$(
            printf '%-3s %-20s %-12s %s\n' \
                "1)" "Repack weights" "[$repack_state]" "on = AVX512 only, costs a full RAM copy; off = mmap'd, no copy" \
                "2)" "Prompt cache MiB" "[$RAM_CACHE_MIB]" "llama-server host prompt cache (0=off, -1=unlimited)" \
                "3)" "Context checkpoints" "[$RAM_CTXCP]" "per-slot KV checkpoint copies (0=off)" \
                "4)" "Idle unload sec" "[$RAM_IDLE_SEC]" "server unloads the model when idle (1+ = seconds, -1 = never)" \
                "R)" "Reset to defaults" "" "" |
            fzf --prompt="RAM > " | awk '{print $1}' | tr -d ')'
        )
        [ -z "$choice" ] && return
        case "$choice" in
            1) [ "$RAM_NO_REPACK" = "1" ] && RAM_NO_REPACK=0 || RAM_NO_REPACK=1 ;;
            2) read -p "Prompt cache MiB (current: $RAM_CACHE_MIB, 0=off, -1=unlimited): " v
               [[ "$v" =~ ^-?[0-9]+$ ]] && RAM_CACHE_MIB="$v" ;;
            3) read -p "Context checkpoints (current: $RAM_CTXCP, 0=off): " v
               [[ "$v" =~ ^[0-9]+$ ]] && RAM_CTXCP="$v" ;;
            4) read -p "Idle unload seconds (current: $RAM_IDLE_SEC, -1=never, 1+): " v
               [[ "$v" =~ ^-?[0-9]+$ ]] && [ "$v" -ge -1 ] && [ "$v" != "0" ] && RAM_IDLE_SEC="$v" ;;
            R) RAM_NO_REPACK=$RAM_DEF_NO_REPACK; RAM_CACHE_MIB=$RAM_DEF_CACHE_MIB
               RAM_CTXCP=$RAM_DEF_CTXCP; RAM_IDLE_SEC=$RAM_DEF_IDLE_SEC ;;
        esac
    done
}

configure_settings() {
    while true; do
        local w_desc="\e[97m"
        local w_res="\e[0m"
        local options=$(
            if [ "$S_MIROSTAT" == "0" ]; then
            printf "%-3s %-25s %-22s %b%s%b\n" "1)" "Temperature" "[$S_TEMP]" "$w_desc" "- Controls randomness (0 = greedy, higher = creative)" "$w_res"
            fi
            if [ "$S_MIROSTAT" == "0" ]; then
        printf "%-3s %-25s %-22s %b%s%b\n" "2)" "Top-P" "[$S_TOP_P]" "$w_desc" "- Nucleus sampling (1.0 = off, lower = stricter)" "$w_res"
        printf "%-3s %-25s %-22s %b%s%b\n" "3)" "Top-K" "[$S_TOP_K]" "$w_desc" "- Limits to top K most likely tokens (0 = off)" "$w_res"
        printf "%-3s %-25s %-22s %b%s%b\n" "4)" "Min-P" "[$S_MIN_P]" "$w_desc" "- Drops tokens below fraction of top prob (0.0 = off)" "$w_res"
        printf "%-3s %-25s %-22s %b%s%b\n" "5)" "Typical" "[$S_TYPICAL]" "$w_desc" "- Locally typical sampling (1.0 = off, lower = strict)" "$w_res"
            fi
        printf "%-3s %-25s %-22s %b%s%b\n" "6)" "Mirostat" "[$S_MIROSTAT]" "$w_desc" "- Actively maintains a target entropy (0=off, 1/2=on)" "$w_res"
            if [ "$S_MIROSTAT" != "0" ]; then
        printf "%-3s %-25s %-22s %b%s%b\n" "7)" "Mirostat LR" "[$S_MIROSTAT_LR]" "$w_desc" "- Learning rate for Mirostat (default 0.1)" "$w_res"
        printf "%-3s %-25s %-22s %b%s%b\n" "8)" "Mirostat ENT" "[$S_MIROSTAT_ENT]" "$w_desc" "- Target entropy (perplexity) for Mirostat (default 5.0)" "$w_res"
            fi
            if [ "$S_MIROSTAT" == "0" ]; then
        printf "%-3s %-25s %-22s %b%s%b\n" "9)" "Presence Penalty" "[$S_PRESENCE]" "$w_desc" "- Penalizes based on presence (0.0 = off, higher = more)" "$w_res"
        printf "%-3s %-25s %-22s %b%s%b\n" "10)" "Frequency Penalty" "[$S_FREQUENCY]" "$w_desc" "- Penalizes based on frequency (0.0 = off, higher = more)" "$w_res"
        printf "%-3s %-25s %-22s %b%s%b\n" "11)" "Repeat Penalty" "[$S_PENALTY_REPEAT]" "$w_desc" "- Penalizes exact sequences (1.0 = off, higher = more)" "$w_res"
        printf "%-3s %-25s %-22s %b%s%b\n" "12)" "Penalty Last N" "[$S_PENALTY_LAST_N]" "$w_desc" "- Number of prev tokens to consider (-1 = ctx, 0 = off)" "$w_res"
            fi
        printf "%-3s %-25s %-22s %b%s%b\n" "13)" "Speculative Type" "[$S_SPEC_TYPE]" "$w_desc" "- Mechanism to guess future tokens (ngram, eagle)" "$w_res"
        printf "%-3s %-25s %-22s %b%s%b\n" "14)" "Speculative Draft Max" "[$S_SPEC_N_MAX]" "$w_desc" "- Maximum tokens to guess per step" "$w_res"
        printf "%-3s %-25s %-22s %b%s%b\n" "15)" "Speculative Draft Min" "[$S_SPEC_N_MIN]" "$w_desc" "- Minimum tokens to guess per step" "$w_res"
        printf "%-3s %-25s %-22s %b%s%b\n" "16)" "Context Size (0=auto)" "[$S_CTX_SIZE]" "$w_desc" "- Maximum number of tokens the model can remember" "$w_res"
        printf "%-3s %-25s %-22s %b%s%b\n" "17)" "Draft Model Path" "[$S_DRAFT_MODEL]" "$w_desc" "- External draft model file for speculation" "$w_res"
        if [ "$S_MIROSTAT" == "0" ]; then
        printf "%-3s %-25s %-22s %b%s%b\n" "18)" "XTC Probability" "[$S_XTC_PROB]" "$w_desc" "- Exclude Top Choices prob (0.0 = off, default; 0.2 = recommended)" "$w_res"
        printf "%-3s %-25s %-22s %b%s%b\n" "19)" "XTC Threshold" "[$S_XTC_THRESH]" "$w_desc" "- Threshold for XTC triggering (only used when XTC on)" "$w_res"
        fi
        repack_state="repack"
        [ "$RAM_NO_REPACK" = "1" ] && repack_state="no-repack"
        printf "%-3s %-25s %-22s %b%s%b\n" "20)" "Memory / RAM" "[$repack_state,cache:${RAM_CACHE_MIB}M,ckpt:${RAM_CTXCP},idle:${RAM_IDLE_SEC}s]" "$w_desc" "- repack, prompt cache, checkpoints, idle unload" "$w_res"
        printf "%-3s %-25s %-22s %b%s%b\n" "S)" "Save & Exit" "" "" "" ""
        printf "%-3s %-25s %-22s %b%s%b\n" "R)" "Save & Run Model" "" "" "" ""
        )

        local choice=$(echo -e "$options" | fzf --ansi --prompt="Settings > " | awk '{print $1}' | tr -d ')')
        [ -z "$choice" ] && break

        case "$choice" in
            1) read -p "Enter new Temperature (current: $S_TEMP): " val; [ -n "$val" ] && S_TEMP="$val" ;;
            2) read -p "Enter new Top-P (current: $S_TOP_P): " val; [ -n "$val" ] && S_TOP_P="$val" ;;
            3) read -p "Enter new Top-K (current: $S_TOP_K): " val; [ -n "$val" ] && S_TOP_K="$val" ;;
            4) read -p "Enter new Min-P (current: $S_MIN_P): " val; [ -n "$val" ] && S_MIN_P="$val" ;;
            5) read -p "Enter new Typical (current: $S_TYPICAL): " val; [ -n "$val" ] && S_TYPICAL="$val" ;;
            6) 
                local val=$(echo -e "0\n1\n2" | fzf --prompt="Mirostat > ")
                [ -n "$val" ] && S_MIROSTAT="$val"
                ;;
            7) read -p "Enter new Mirostat LR (current: $S_MIROSTAT_LR): " val; [ -n "$val" ] && S_MIROSTAT_LR="$val" ;;
            8) read -p "Enter new Mirostat ENT (current: $S_MIROSTAT_ENT): " val; [ -n "$val" ] && S_MIROSTAT_ENT="$val" ;;
            9) read -p "Enter new Presence Penalty (current: $S_PRESENCE): " val; [ -n "$val" ] && S_PRESENCE="$val" ;;
            10) read -p "Enter new Frequency Penalty (current: $S_FREQUENCY): " val; [ -n "$val" ] && S_FREQUENCY="$val" ;;
            11) read -p "Enter new Repeat Penalty (current: $S_PENALTY_REPEAT): " val; [ -n "$val" ] && S_PENALTY_REPEAT="$val" ;;
            12) read -p "Enter new Penalty Last N (current: $S_PENALTY_LAST_N): " val; [ -n "$val" ] && S_PENALTY_LAST_N="$val" ;;
            13) 
                local val=$(echo -e "none\ndraft-simple\ndraft-eagle3\ndraft-dflash\ndraft-dspark\ndraft-mtp\nngram-cache\nngram-simple\nngram-map-k\nngram-map-k4v\nngram-mod" | fzf --prompt="Spec Type > ")
                [ -n "$val" ] && S_SPEC_TYPE="$val"
                ;;
            14) read -p "Enter new Speculative Draft Max (current: $S_SPEC_N_MAX): " val; [ -n "$val" ] && S_SPEC_N_MAX="$val" ;;
            15) read -p "Enter new Speculative Draft Min (current: $S_SPEC_N_MIN): " val; [ -n "$val" ] && S_SPEC_N_MIN="$val" ;;
            16) read -p "Enter new Context Size (current: $S_CTX_SIZE): " val; [ -n "$val" ] && S_CTX_SIZE="$val" ;;
            17) 
                local dm_src=$(echo -e "From Model List\nEnter Path\nDisable" | fzf --prompt="Draft Model Source > ")
