run_model() {

    [ ! -f "$MODEL_LIST_FILE" ] && { echo "No models!"; exit 1; }
    local selected=$(cat "$MODEL_LIST_FILE" | awk -F'|' '{printf "%2d) %-20s [%s]\n", NR, $1, $3}' | fzf_with_usage models --prompt="Select model > ")
    [ -z "$selected" ] && return
    
    local index=$(echo "$selected" | awk '{print $1}' | tr -d ')')
    IFS='|' read -r selected_alias selected_path selected_custom <<< "$(sed "${index}q;d" "$MODEL_LIST_FILE")"
    build_ram_args
    # precedence: defaults < RAM knobs < per-model args < explicit CLI args
    final_args="$DEFAULT_MODEL_ARGS $PROFILE_ARGS $selected_custom ${EXTRA_ARGS[*]}"
    # per-model + CLI args are written in mainline spelling; ik needs its own names
    final_args=$(translate_spec_args_ik "$final_args")
    # embed models: server clamps ubatch to batch, so raise BOTH (else -ub 8096 -> 2048)
    # full 1120 image tokens need ub ~2300+; use 4096/4096 unless user overrode
    _lname=$(basename "$selected_path" | tr 'A-Z' 'a-z')
    case "$_lname" in *embed*)
        case " $selected_custom ${EXTRA_ARGS[*]} " in *" -ub "*|*" --ubatch"*) ;;
            *) final_args=$(echo "$final_args" | sed -E 's/(^| )-ub [0-9]+/\1-ub 4096/') ;;
        esac
        case " $selected_custom ${EXTRA_ARGS[*]} " in *" -b "*|*" --batch"*) ;;
            *) final_args=$(echo "$final_args" | sed -E 's/(^| )-b [0-9]+/\1-b 4096/')
               case " $final_args " in *" -b "*) ;; *) final_args="-b 4096 $final_args" ;; esac ;;
        esac
        case " $final_args " in *" --embedding"*) ;; *) final_args="$final_args --embeddings" ;; esac
        ;;
    esac
    # user override wins (llama-server last-wins)

    # Setup model-specific speculative decoding lookup cache
    local safe_alias=$(echo "$selected_alias" | tr -dc 'a-zA-Z0-9_-')
    local model_cache="$BASE_DIR/cache/${safe_alias}.cache"
    touch "$model_cache"
    SERVER_ARGS="$SERVER_ARGS -lcd $model_cache"


    local mode_menu="1) CLI\n2) Server\n3) Public\n4) Silly\n5) OpenCode\n6) Odysseus\n7) Codehamr\n8) Hermes\n9) Pi\n10) Little-coder\n11) Deepseek-harness\n12) MykyAgent"
    local mode=$(echo -e "$mode_menu" | fzf_with_usage modes --prompt="Mode > " | awk '{print $1}' | tr -d ')')
    [ -z "$mode" ] && return
    
    case $mode in
        1) select_prompt
           [ ! -x "$LLAMA_DIR/build/bin/llama-cli" ] && { echo "Error: llama-cli not compiled!"; return; }
           run_pinned "$LLAMA_DIR/build/bin/llama-cli" -m "$selected_path" ${selected_prompt:+--system-prompt-file "$selected_prompt"} --no-display-prompt $final_args ;;
        2) [ ! -x "$LLAMA_DIR/build/bin/llama-server" ] && { echo "Error: llama-server not compiled!"; return; }
           # Prepend server-mode flags now that we know the mode
           final_args="$SERVER_ARGS $PROFILE_SERVER_ARGS $final_args"
           run_pinned "$LLAMA_DIR/build/bin/llama-server" -m "$selected_path" $final_args --port "$DEFAULT_PORT" ;;
        3) [ ! -x "$LLAMA_DIR/build/bin/llama-server" ] && { echo "Error: llama-server not compiled!"; return; }
           # Prepend server-mode flags now that we know the mode
           final_args="$SERVER_ARGS $PROFILE_SERVER_ARGS --api-key $API_KEY $final_args"
           local ips=$(ip -br addr show | awk '$1 != "lo" && $2 == "UP" {gsub(/\/[0-9]+/, "", $0); out="[" $1 "]"; for(i=3;i<=NF;i++) if($i !~ /^fe80:/) out=out " " $i; print out}' | paste -sd " | " -)
           echo "[Server] Public IPs: $ips"
           run_pinned "$LLAMA_DIR/build/bin/llama-server" -m "$selected_path" $final_args --host 0.0.0.0 --port "$DEFAULT_PORT" ;;
        4) launch_sillytavern ;;
        5) launch_opencode ;;
        6) launch_odysseus ;;
        7) launch_codehamr ;;
        8) launch_hermes ;;
        9) launch_pi ;;
        10) launch_littlecoder ;;
        11) launch_deepseek ;;
        12) launch_mykyagent ;;
        *) ;;
    esac
}

