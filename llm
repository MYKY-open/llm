run_opencode_standalone() {
    local remote_host="$1"
    local base_url
    if [ -n "$remote_host" ]; then
        if [[ "$remote_host" == *:* ]]; then
            base_url="http://$remote_host/v1"
        else
            base_url="http://$remote_host:$DEFAULT_PORT/v1"
        fi
        echo "[OpenCode] Connecting to remote server at $base_url"
    else
        base_url="http://127.0.0.1:$DEFAULT_PORT/v1"
    fi

    local OC_BIN="${HOME}/.opencode/bin/opencode"
    if [ ! -x "$OC_BIN" ]; then
        echo "OpenCode is not installed locally!"
        install_opencode || exit 1
    fi

    # opencode reads config from ~/.config/opencode/opencode.jsonc
    local OC_CFG="${HOME}/.config/opencode/opencode.jsonc"
    mkdir -p "$(dirname "$OC_CFG")"

    if [ -n "$selected_alias" ]; then
        export SELECTED_ALIAS="$selected_alias"
    elif [ -n "$remote_host" ]; then
        export SELECTED_ALIAS="remote"
    else
        export SELECTED_ALIAS=""
    fi
    export BASE_URL="$base_url"
    export API_KEY

    if [ -z "$SELECTED_CTX" ] && [ -n "$SELECTED_ALIAS" ]; then
        probe_remote_ctx "$BASE_URL" "$API_KEY"
    fi

    # Inject the llm-perf provider into the real opencode config
    # Fetch models from the server so they always appear in the picker
    local server_models
    server_models=$(curl -sf "$base_url/models" | node -e '
        let d=""; process.stdin.on("data",c=>d+=c).on("end",()=>{
            try {
                const j=JSON.parse(d);
                const ids=(j.data||j.models||[]).map(m=>m.id||m.name||m.model).filter(Boolean);
                console.log(ids.join("\n"));
            } catch(e) { process.exit(1); }
        });
    ' 2>/dev/null) || true

    OPENCODE_CFG="$OC_CFG" \
    SERVER_MODELS="$server_models" \
    node -e '
    const fs = require("fs");
    const path = process.env.OPENCODE_CFG;
    const alias = process.env.SELECTED_ALIAS;
    const baseUrl = process.env.BASE_URL;
    const apiKey = process.env.API_KEY || "dummy";
    const serverModels = (process.env.SERVER_MODELS || "").split("\n").filter(Boolean);

    let cfg = { "$schema": "https://opencode.ai/config.json" };
    try {
        if (fs.existsSync(path)) {
            const content = fs.readFileSync(path, "utf8");
            cfg = JSON.parse(content.replace(/\/\*[\s\S]*?\*\/|\/\/.*/g, "").replace(/,\s*([\}\]])/g, "$1"));
        }
    } catch (e) {
        console.warn("Notice: Could not parse existing config, starting fresh.");
    }

    cfg.provider = cfg.provider || {};
    const models = {};

    // Add all models reported by the server
    for (const id of serverModels) {
        const shortId = id.split("/").pop().split("\\\\").pop().replace(/\.gguf$/i, ""); // strip path + extension
        models[shortId] = { name: shortId };
    }
    // Always include the selected alias if set
    if (alias && !models[alias]) {
        models[alias] = { name: alias };
    }
    // Fallback: at least one entry so picker shows the provider
    if (Object.keys(models).length === 0) {
        models["default"] = { name: "default" };
    }

    cfg.provider["llm-perf"] = {
        npm: "@ai-sdk/openai-compatible",
        name: "llm-perf",
        options: { baseURL: baseUrl, apiKey: apiKey },
        models
    };
    fs.writeFileSync(path, JSON.stringify(cfg, null, 2));
    console.log("[OpenCode] Registered models:", Object.keys(models).join(", "));
    ' 2>/dev/null || echo "Warning: Failed to auto-update OpenCode config."

    # Launch OpenCode
    if [ -n "$SELECTED_ALIAS" ]; then
        echo "Starting OpenCode with local model: $SELECTED_ALIAS"
        "$OC_BIN" --model "llm-perf/$SELECTED_ALIAS"
    else
        "$OC_BIN"
    fi
}

launch_opencode() {
    start_llama_server "$DEFAULT_PORT"
    run_opencode_standalone
    kill "$llama_pid" 2>/dev/null
}

